# TaxSimba backend-node — STAGING environment template
# Names and safe non-secret examples only. Never put real secrets in git.
# Source of truth: repository audit on cursor/p0-uat-corrections-80a7 @ d60141e…
#
# TaxSimba must supply values marked <SUPPLY_SECURELY> out-of-band.
# Toxel configures non-secret staging values for the staging environment only.
# Use a dedicated staging database. Do not point at production.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
PORT=8002

# ---------------------------------------------------------------------------
# Database (staging-only DB)
# ---------------------------------------------------------------------------
MONGO_URL=<SUPPLY_SECURELY>
DB_NAME=taxsimba_staging

# ---------------------------------------------------------------------------
# Auth / sessions
# ---------------------------------------------------------------------------
JWT_SECRET=<SUPPLY_SECURELY>

# HTTPS staging must use COOKIE_SECURE=true
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# ---------------------------------------------------------------------------
# CORS / proxy
# Comma-separated. Include BOTH client and admin public origins. No wildcard *.
# ---------------------------------------------------------------------------
CORS_ORIGINS=https://<CLIENT-ORIGIN>,https://<ADMIN-ORIGIN>
CORS_DEV_ORIGINS=
# Required by login lockout / X-Forwarded-For handling behind ingress
TRUSTED_PROXY_CIDRS=<TOXEL_CONFIGURES_IF_REQUIRED>

# ---------------------------------------------------------------------------
# Public client origin for links in emails (verification, password reset, CTAs)
# NOT the admin origin. NOT the API host. NOT localhost.
# ---------------------------------------------------------------------------
APP_BASE_URL=https://<CLIENT-ORIGIN>

# ---------------------------------------------------------------------------
# Demo seed — MUST be the string false on staging/production
# If unset or any other value, startup seeds demo data.
# ---------------------------------------------------------------------------
SEED_DEMO_DATA=false

# ---------------------------------------------------------------------------
# Transactional email
# EMAIL_DRIVER defaults to "none" in code when unset → NO verification email.
# For real inbox delivery set smtp OR resend (not both simultaneously).
# ---------------------------------------------------------------------------
EMAIL_DRIVER=smtp
EMAIL_FROM=<VERIFIED-SENDER>
EMAIL_REPLY_TO=
EMAIL_MAX_ATTEMPTS=5
# Optional Contact Us inbox (falls back to EMAIL_REPLY_TO, then EMAIL_FROM)
CONTACT_TO=

# --- SMTP path (when EMAIL_DRIVER=smtp) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=<SUPPLY_SECURELY>
# Variable name is SMTP_PASSWORD (not SMTP_PASS)
SMTP_PASSWORD=<SUPPLY_SECURELY>

# --- Resend path (ALTERNATIVE to SMTP; set EMAIL_DRIVER=resend instead) ---
# EMAIL_DRIVER=resend
# RESEND_API_KEY=<SUPPLY_SECURELY>

# ---------------------------------------------------------------------------
# Stripe TEST mode only during UAT
# Webhook endpoint (backend): POST /api/stripe/webhook
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=<SUPPLY_SECURELY>
STRIPE_WEBHOOK_SECRET=<SUPPLY_SECURELY>

# ---------------------------------------------------------------------------
# Object storage (profile photos + documents)
# Default driver in code is s3 when unset.
# ---------------------------------------------------------------------------
STORAGE_DRIVER=s3
S3_BUCKET=
S3_REGION=eu-west-2
S3_ACCESS_KEY_ID=<SUPPLY_SECURELY>
S3_SECRET_ACCESS_KEY=<SUPPLY_SECURELY>
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=true

# Local storage ALTERNATIVE (not typical for shared staging):
# STORAGE_DRIVER=local
# LOCAL_STORAGE_DIR=./.storage

# ---------------------------------------------------------------------------
# Staff MFA (conditional — only if staff TOTP/MFA is used on staging)
# ---------------------------------------------------------------------------
TOTP_FERNET_KEY=<SUPPLY_SECURELY>
TOTP_ISSUER=TaxSimba

# ---------------------------------------------------------------------------
# Limits / workers (repository defaults)
# ---------------------------------------------------------------------------
API_RATE_LIMIT_PER_MINUTE=300
MAX_UPLOAD_MB=25
REMINDERS_ENABLED=false
# Reminder cadence vars exist only if REMINDERS_ENABLED=true; leave worker off
# unless TaxSimba explicitly asks to enable it on exactly one instance.
