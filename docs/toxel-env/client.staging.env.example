# TaxSimba tax_simba_frontend — STAGING environment template
# Names and safe non-secret examples only. Never put real secrets in git.
# Source of truth: repository audit on cursor/p0-uat-corrections-80a7 @ d60141e…
#
# Trailing slash on NEXT_PUBLIC_API_URL and API_URL is REQUIRED
# (callers concatenate paths like `${NEXT_PUBLIC_API_URL}auth/register`).

# ---------------------------------------------------------------------------
# Backend API (Node compat layer)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=https://<STAGING-API-HOST>/api/compat/
API_URL=https://<STAGING-API-HOST>/api/compat/

# ---------------------------------------------------------------------------
# NextAuth — CLIENT public origin (no /admin)
# ---------------------------------------------------------------------------
NEXTAUTH_URL=https://<CLIENT-ORIGIN>
NEXTAUTH_SECRET=<SUPPLY_SECURELY>
NEXTAUTH_TRUST_HOST=true

# ---------------------------------------------------------------------------
# Public site URL / staging flag
# ---------------------------------------------------------------------------
NEXT_PUBLIC_BASE_URL=https://<CLIENT-ORIGIN>
NEXT_PUBLIC_IS_STAGING=true

# ---------------------------------------------------------------------------
# Optional — established by audit; not required for verification-email UAT
# ---------------------------------------------------------------------------
# Stripe TEST publishable key only (pk_test_…). Secret keys never go here.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_<TEST_KEY>

# Native API host helper (optional; otherwise derived from NEXT_PUBLIC_API_URL)
NEXT_PUBLIC_NODE_JS_URL=https://<STAGING-API-HOST>

# ---------------------------------------------------------------------------
# Optional / NOT a P0 staging gate (do not invent credentials)
# Present in source for chatbot / translate / SimbaX links only.
# Omit unless TaxSimba explicitly enables those features on staging.
# ---------------------------------------------------------------------------
# OPENAI_API_KEY=<SUPPLY_SECURELY>
# GOOGLE_TRANSLATE_API_KEY=<SUPPLY_SECURELY>
# NEXT_PUBLIC_SIMBAX_PLATFORM_URL=
