# TaxSimba tax_simba_admin_frontend — STAGING environment template
# Names and safe non-secret examples only. Never put real secrets in git.
# Source of truth: repository audit on cursor/p0-uat-corrections-80a7 @ d60141e…
#
# CRITICAL: this app has hardcoded Next.js basePath: '/admin'
# Therefore NEXTAUTH_URL MUST include /admin.
# SessionProvider uses basePath "/admin/api/auth".
#
# Trailing slash on NEXT_PUBLIC_API_URL and BACKEND_URL is REQUIRED.

# ---------------------------------------------------------------------------
# Backend API (Node compat layer)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=https://<STAGING-API-HOST>/api/compat/
# Server-side NextAuth staff login target (same compat base)
BACKEND_URL=https://<STAGING-API-HOST>/api/compat/

# ---------------------------------------------------------------------------
# NextAuth — ADMIN public origin INCLUDING /admin
# Example: https://staging-admin.example.com/admin
# Do NOT set this to the client origin or omit /admin.
# ---------------------------------------------------------------------------
NEXTAUTH_URL=https://<ADMIN-ORIGIN>/admin
NEXTAUTH_SECRET=<SUPPLY_SECURELY>
NEXTAUTH_TRUST_HOST=true
