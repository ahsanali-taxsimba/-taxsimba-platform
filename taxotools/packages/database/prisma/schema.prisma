// ─── seo.backlinks.init engine ────────────────────────────────────────────────

model BacklinkEngineConfig {
  id                         String   @id @default(cuid())
  siteId                     String   @unique
  sourceApis                 Json
  crawlMode                  String   @default("external")
  refreshInterval            String   @default("24h")
  refreshIntervalHours       Int      @default(24)
  scoreFormula               String   @default("(authority*relevance)-(spam*risk)")
  toxicSpamGt                Float    @default(70)
  toxicRiskGt                Float    @default(0.6)
  highValueAuthorityGt       Float    @default(40)
  highValueRelevanceGt       Float    @default(0.7)
  alertVelocitySpikePct      Float    @default(30)
  alertAnchorRepeatPct       Float    @default(20)
  enableDisavow              Boolean  @default(true)
  enableCompetitorMonitoring Boolean  @default(true)
  lastRefreshAt              DateTime?
  nextRefreshAt              DateTime?
  status                     String   @default("active")
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)
}

model BacklinkAlert {
  id        String   @id @default(cuid())
  siteId    String
  rule      String
  severity  String   @default("warning")
  message   String
  metric    Float?
  threshold Float?
  metadata  Json?
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, resolved])
  @@index([siteId, rule])
}

model DisavowEntry {
  id         String   @id @default(cuid())
  siteId     String
  domain     String?
  url        String?
  reason     String?
  source     String   @default("engine")
  status     String   @default("pending")
  createdAt  DateTime @default(now())
  exportedAt DateTime?

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, status])
  @@unique([siteId, domain, url])
}

// ─── seo.crawler.master.init ──────────────────────────────────────────────────
// DB schema: projects, crawler_configs, crawl_jobs, backlinks,
//            serp_snapshots, raw_documents, crawler_logs

model CrawlerProject {
  id          String   @id @default(cuid())
  siteId      String   @unique
  name        String
  domain      String
  status      String   @default("active")
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@map("projects")
}

model CrawlerMasterConfig {
  id                     String   @id @default(cuid())
  siteId                 String   @unique
  enableModules          Json     @default("[]")
  modules                Json
  providers              Json
  ukDirectories          Json     @default("[]")
  accountingDirectories  Json     @default("[]")
  govSources             Json     @default("[]")
  queues                 Json     @default("[]")
  workers                Json     @default("[]")
  dbSchema               Json     @default("[]")
  crawlModes             Json
  frequency              String   @default("6h")
  frequencyHours         Int      @default(6)
  maxDepth               Int      @default(12)
  parallelThreads        Int      @default(32)
  respectRobots          Boolean  @default(true)
  extractFields          Json
  storeFormat            String   @default("jsonl")
  autoClean              Boolean  @default(true)
  errorRetry             Int      @default(3)
  logLevel               String   @default("verbose")
  status                 String   @default("active")
  lastRunAt              DateTime?
  nextRunAt              DateTime?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@map("crawler_configs")
}

model CrawlerMasterRun {
  id              String    @id @default(cuid())
  siteId          String
  mode            String
  status          JobStatus @default(QUEUED)
  modules         Json
  providers       Json
  queuesDispatched Json?
  workersInvoked  Json?
  maxDepth        Int       @default(12)
  parallelThreads Int       @default(32)
  pagesCrawled    Int       @default(0)
  extractsStored  Int       @default(0)
  errors          Int       @default(0)
  retries         Int       @default(0)
  storePath       String?
  logLevel        String    @default("verbose")
  logs            Json?
  startedAt       DateTime?
  finishedAt      DateTime?
  createdAt       DateTime  @default(now())

  site     Site                   @relation(fields: [siteId], references: [id], onDelete: Cascade)
  extracts CrawlerExtractRecord[]

  @@index([siteId, createdAt])
  @@index([siteId, status])
  @@map("crawl_jobs")
}

model CrawlerExtractRecord {
  id          String   @id @default(cuid())
  siteId      String
  runId       String?
  url         String
  depth       Int      @default(0)
  module      String
  provider    String?
  queue       String?
  worker      String?
  links       Json?
  anchors     Json?
  metadata    Json?
  schemas     Json?
  keywords    Json?
  geo         Json?
  language    String?
  rawJsonl    String?
  cleaned     Boolean  @default(false)
  createdAt   DateTime @default(now())

  site Site              @relation(fields: [siteId], references: [id], onDelete: Cascade)
  run  CrawlerMasterRun? @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@index([siteId, module])
  @@index([runId])
  @@index([siteId, createdAt])
  @@map("raw_documents")
}

model SerpSnapshot {
  id           String   @id @default(cuid())
  siteId       String
  query        String
  provider     String
  device       String   @default("desktop")
  location     String?
  resultsJson  Json
  featuresJson Json?
  createdAt    DateTime @default(now())

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, query])
  @@index([siteId, createdAt])
  @@map("serp_snapshots")
}

model CrawlerLog {
  id        String   @id @default(cuid())
  siteId    String
  runId     String?
  queue     String?
  worker    String?
  level     String   @default("info")
  message   String
  meta      Json?
  createdAt DateTime @default(now())

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, createdAt])
  @@index([siteId, level])
  @@map("crawler_logs")
}
