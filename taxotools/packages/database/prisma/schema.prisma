// ─── Search Atlas–parity automation (Taxo Agent / Auto SEO) ───────────────────

model AutoSeoAction {
  id           String              @id @default(cuid())
  siteId       String
  category     AutoSeoCategory
  title        String
  description  String
  targetUrl    String?
  deployVia    AutoSeoDeployVia    @default(PIXEL)
  status       AutoSeoActionStatus @default(PENDING)
  impactScore  Int                 @default(50)
  metadata     Json?
  approvedAt   DateTime?
  deployedAt   DateTime?
  rolledBackAt DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, status])
  @@index([siteId, category])
}

enum AutoSeoCategory {
  TECHNICAL
  ON_PAGE
  CONTENT
  SCHEMA
  INTERNAL_LINK
  INDEXING
  LOCAL_GBP
  AUTHORITY
  ADS
  OVERNIGHT_REPAIR
}

enum AutoSeoDeployVia {
  PIXEL
  CLOUDFLARE
  CMS
  CODE_PIPELINE
  MANUAL
}

enum AutoSeoActionStatus {
  PENDING
  AWAITING_APPROVAL
  APPROVED
  DEPLOYED
  FAILED
  ROLLED_BACK
  SKIPPED
}

model CmsPublishJob {
