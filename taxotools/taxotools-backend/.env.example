# Supabase Project
SUPABASE_URL="https://YOUR-SUPABASE-PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_KEY"
SUPABASE_ANON_KEY="YOUR_ANON_KEY"

# Also accepted from Taxotools monorepo:
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Open PageRank API (free authority scoring)
OPEN_PAGERANK_API_KEY="YOUR_OPEN_PAGERANK_KEY"
# OPENPAGERANK_API_KEY=

# Keywords Everywhere API (optional phase-2 — leave empty to skip keyword collection)
KEYWORDS_EVERYWHERE_API_KEY=
# Set true only when you want keyword crawling without a KE key (heuristic)
COLLECT_KEYWORDS=false

# Optional PageSpeed Insights for Core Web Vitals
PAGESPEED_API_KEY=

# Companies House API (for accountant discovery)
COMPANIES_HOUSE_API_KEY="YOUR_COMPANIES_HOUSE_KEY"

# Optional Google discovery via SerpAPI
SERP_API_KEY=

# Common Crawl index id
COMMON_CRAWL_INDEX="CC-MAIN-2026-17"

# Crawler Settings
CRAWL_DELAY_MS=500
MAX_PAGES_PER_DOMAIN=200
USER_AGENT="TaxoToolsBot/1.0 (+https://taxotools.com)"
BACKEND_PORT=3200
CONTINUOUS_LOOP_SLEEP_MS=60000
CONTINUOUS_FIRM_BATCH=5

# For npm run db:apply
DIRECT_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"
