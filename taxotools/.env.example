# Taxotools environment — copy to .env and fill in values
# Keep Taxotools ports isolated: web=3100, postgres=5433, redis=6380

# App
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3100
APP_URL=http://localhost:3100

# Database (Taxotools-only Postgres on 5433)
DATABASE_URL=postgresql://taxotools:taxotools@localhost:5433/taxotools?schema=public

# Redis (Taxotools-only on 6380)
REDIS_URL=redis://localhost:6380

# Auth (Auth.js / NextAuth)
AUTH_SECRET=change-me-to-a-long-random-string
AUTH_URL=http://localhost:3100
NEXTAUTH_URL=http://localhost:3100
NEXTAUTH_SECRET=change-me-to-a-long-random-string

# OAuth (optional)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_AGENCY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# AI providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_DEFAULT_PROVIDER=openai

# SEO / crawl integrations (optional — stubs work without keys)
PAGESPEED_API_KEY=
SERP_API_KEY=
BACKLINK_API_KEY=

# Free backlink providers (@taxotools/integrations)
# CrawlGraph: https://crawlgraph.com/docs/api — 15 free lookups/mo
CRAWLGRAPH_API_KEY=
# Open PageRank (Keywords Everywhere): https://openpagerank.keywordseverywhere.com/
OPENPAGERANK_API_KEY=
KEYWORDS_EVERYWHERE_API_KEY=

# S3-compatible storage
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=taxotools
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Worker
WORKER_CONCURRENCY=5
