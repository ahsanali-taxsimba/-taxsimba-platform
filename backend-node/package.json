    "otplib": "12.0.1",
    "stripe": "16.12.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "1.4.7",
    "@types/cors": "2.8.17",
