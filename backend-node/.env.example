# TaxSimba Node backend — placeholders only. Never commit real values.

# Runtime
PORT=8002

# Database (use a dedicated database; never the operational Python one during migration)
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=taxsimba_node

# Sessions
JWT_SECRET=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Staff MFA. Production MUST reuse the existing Python TOTP_FERNET_KEY or enrolled staff
# secrets become undecryptable. Rotation requires a re-encryption procedure.
TOTP_FERNET_KEY=
TOTP_ISSUER=TaxSimba

# CORS / proxy
CORS_ORIGINS=https://app.example.com
CORS_DEV_ORIGINS=
TRUSTED_PROXY_CIDRS=10.0.0.0/8

# Object storage (s3 for staging/production, local for automated tests)
STORAGE_DRIVER=s3
S3_ENDPOINT=
S3_REGION=eu-west-2
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
LOCAL_STORAGE_DIR=./.storage

# Payments (test mode only during migration)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Limits
API_RATE_LIMIT_PER_MINUTE=300
MAX_UPLOAD_MB=25

# Absolute public HTTPS base URL used for links in emails (client portal origin, no path).
# MUST be publicly reachable HTTPS — never localhost, 127.0.0.1, or RFC1918 (192.168/10/172.16-31).
# Outlook/Gmail cannot load private hosts (blank logo + broken Privacy/Terms/Contact links).
# Invalid config persists a FAILED email_messages row (EMAIL_PUBLIC_URL_CONFIG) — mail is not silently dropped.
APP_BASE_URL=https://app.example.com

# Absolute Admin portal origin (no /admin path). Staff invite emails use
# {ADMIN_BASE_URL}/admin/invite/{token}. Required on staging/production. Must be public HTTPS.
ADMIN_BASE_URL=https://admin.example.com

# Optional absolute HTTPS PNG for email header logo (Gmail/Outlook-safe, white-on-green).
# Defaults to {APP_BASE_URL}/images/email-logo.png when unset (NOT logo.png — brand-green
# logo.png is invisible on the #37a267 email header).
# EMAIL_LOGO_URL=https://app.example.com/images/email-logo.png

# Optional public HTTPS origin for Privacy / Terms / Contact when the marketing/legal site
# differs from APP_BASE_URL (e.g. staging app on *.onrender.com, legal on https://taxsimba.co.uk).
# Defaults to APP_BASE_URL when unset.
# EMAIL_LEGAL_BASE_URL=https://taxsimba.co.uk

# After changing APP_BASE_URL / EMAIL_LOGO_URL / EMAIL_LEGAL_BASE_URL / EMAIL_DRIVER: restart the API
# process and any reminder/email worker. Old queued HTML is not rewritten — only new sends pick up the fix.
# Transactional email. none = disabled (in-app notifications still work normally).
EMAIL_DRIVER=none
EMAIL_FROM=TaxSimba <no-reply@example.com>
EMAIL_REPLY_TO=
# Optional inbox for POST /api/compat/contact-us (defaults to EMAIL_REPLY_TO, then EMAIL_FROM)
# CONTACT_TO=support@example.com
EMAIL_MAX_ATTEMPTS=5
# EMAIL_DRIVER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# EMAIL_DRIVER=resend
RESEND_API_KEY=

# Scheduled reminder worker (enable on exactly one instance)
REMINDERS_ENABLED=false
REMINDER_INTERVAL_MINUTES=60
REMINDER_REPEAT_DAYS=3
REMINDER_DEADLINE_DAYS=14

# Demo/bootstrap data. MUST be false in production.
SEED_DEMO_DATA=false

# Local / disposable environments only — seeds/reconciles the package catalogue on boot.
# Leave unset (or false) in production.
ALLOW_PACKAGE_CATALOGUE_MUTATION=false

# Local checkout without Stripe: PAYMENT_PROVIDER=fake (requires APP_BASE_URL on localhost).
# PAYMENT_PROVIDER=

# Admin FE origin for staff invite + operational email deep links.
# ADMIN_BASE_URL=https://admin.example.com
# APP_BASE_URL=https://app.example.com
