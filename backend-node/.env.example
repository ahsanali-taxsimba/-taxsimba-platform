# TaxSimba Node backend — placeholders only. Never commit real values.

# Runtime
PORT=8002

# Database (use a dedicated database; never the operational Python one during migration)
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=taxsimba_node

# Sessions
JWT_SECRET=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Staff MFA. Production MUST reuse the existing Python TOTP_FERNET_KEY or enrolled staff
# secrets become undecryptable. Rotation requires a re-encryption procedure.
TOTP_FERNET_KEY=
TOTP_ISSUER=TaxSimba

# CORS / proxy
CORS_ORIGINS=https://app.example.com
CORS_DEV_ORIGINS=
TRUSTED_PROXY_CIDRS=10.0.0.0/8

# Object storage (s3 for staging/production, local for automated tests)
STORAGE_DRIVER=s3
S3_ENDPOINT=
S3_REGION=eu-west-2
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
LOCAL_STORAGE_DIR=./.storage

# Payments (test mode only during migration)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Limits
API_RATE_LIMIT_PER_MINUTE=300
MAX_UPLOAD_MB=25

# Absolute base URL used for links in emails (and as the invite-link fallback)
APP_BASE_URL=https://app.example.com

# Transactional email. none = disabled (in-app notifications still work normally).
EMAIL_DRIVER=none
EMAIL_FROM=TaxSimba <no-reply@example.com>
EMAIL_REPLY_TO=
EMAIL_MAX_ATTEMPTS=5
# EMAIL_DRIVER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# EMAIL_DRIVER=resend
RESEND_API_KEY=

# Scheduled reminder worker (enable on exactly one instance)
REMINDERS_ENABLED=false
REMINDER_INTERVAL_MINUTES=60
REMINDER_REPEAT_DAYS=3
REMINDER_DEADLINE_DAYS=14

# Demo/bootstrap data. MUST be false in production.
SEED_DEMO_DATA=false
