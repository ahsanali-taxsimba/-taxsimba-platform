{
  "name": "@taxsimba/ai-tax-concierge-v2-backend-node",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SIMBA AI Tax Concierge V2 — Node.js Express backend (parity with Python FastAPI)",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "start:dev": "node --import tsx src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "live:openai": "tsx scripts/liveOpenAIVerification.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "openai": "^4.77.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
