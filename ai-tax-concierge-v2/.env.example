# Server-side only — never expose to the browser or embed widget
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=30

# App
CONCIERGE_ENV=development
CONCIERGE_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8090,http://127.0.0.1:8090
CONCIERGE_LOG_LEVEL=INFO

# Force mock LLM even if a key is present (useful for demos/tests)
CONCIERGE_FORCE_MOCK_LLM=false

# Stub adapters until Toxel connects live systems
CONSULTATION_BOOKING_URL=https://calendly.com/example/taxsimba-99-consultation
WEBSITE_BASE_URL=https://www.taxsimba.co.uk

# Dynamic systems (staging)
CONCIERGE_OPS_TOKEN=
CONCIERGE_HMRC_MONITOR_ENABLED=false
CONCIERGE_HMRC_MONITOR_INTERVAL_MS=21600000
CONCIERGE_CATALOGUE_SYNC_ENABLED=false
CONCIERGE_CATALOGUE_SYNC_INTERVAL_MS=900000
# Optional overrides (default: WEBSITE_BASE_URL /api/compat/subscription-plans)
TAXSIMBA_CATALOGUE_API_BASE=
TAXSIMBA_CATALOGUE_SA_URL=
TAXSIMBA_CATALOGUE_MTD_URL=
# Optional writable runtime dir (default: backend-node/data/runtime)
CONCIERGE_RUNTIME_DIR=
