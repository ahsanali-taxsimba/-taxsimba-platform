{
  "name": "my-next15-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run release:deploy-build",
    "start": "next start",
    "lint": "next lint",
    "verify:articles": "node scripts/verify-article-upsert.mjs",
    "release:publish-editorial": "node scripts/publish-editorial-drafts.mjs",
    "verify:article-fields": "node scripts/verify-article-fields.mjs",
    "verify:production-readiness": "node scripts/verify-production-readiness.mjs",
    "verify:premium": "node scripts/verify-premium-articles.mjs",
    "release:prepare": "node scripts/prepare-premium-release.mjs",
    "release:build": "npm run release:prepare && set -a && . ./.env.production.local && set +a && npm run verify:premium && next build && node scripts/prepare-standalone.mjs",
    "release:start": "node --env-file=.env.production.local .next/standalone/server.js",
    "verify:batch01": "node scripts/verify-editorial-batch.mjs",
    "verify:complete-release": "node scripts/verify-editorial-batch.mjs --complete-release",
    "release:deploy-build": "npm run verify:complete-release && npm run verify:priority20 && npm run verify:guide-depth && npm run verify:editorial-v2 && npm run verify:competitive-v3 && npm run verify:quality-v4 && npm run verify:review-v5 && npm run verify:landlord-hub-v6 && npm run release:build",
    "verify:batch02": "node scripts/verify-editorial-batch.mjs --batch=2",
    "verify:priority20": "node scripts/verify-priority20-depth.mjs",
    "verify:batch": "node scripts/verify-editorial-batch.mjs",
    "verify:guide-depth": "node scripts/verify-guide-depth.mjs",
    "verify:editorial-v2": "node scripts/verify-editorial-v2.mjs",
    "verify:competitive-v3": "node scripts/verify-competitive-v3.mjs",
    "verify:quality-v4": "node scripts/verify-quality-v4.mjs",
    "audit:maintenance": "node scripts/check-article-maintenance.mjs",
    "verify:review-v5": "node scripts/verify-review-v5.mjs",
    "verify:landlord-hub-v6": "node scripts/verify-landlord-hub-v6.mjs"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@fortawesome/free-brands-svg-icons": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@fortawesome/react-fontawesome": "^0.2.2",
    "@google-cloud/translate": "^9.2.1",
    "@smastrom/react-rating": "^1.5.0",
    "@stripe/react-stripe-js": "^3.8.0",
    "@stripe/stripe-js": "^7.6.1",
    "@tailwindcss/postcss": "^4.2.0",
    "axios": "^1.9.0",
    "bootstrap": "^5.3.7",
    "clsx": "^2.1.1",
    "framer-motion": "^12.34.3",
    "isotope-layout": "^3.0.6",
    "jspdf": "^3.0.3",
    "lucide-react": "^0.552.0",
    "mitt": "^3.0.1",
    "next": "15.5.22",
    "next-auth": "^4.24.11",
    "openai": "^6.27.0",
    "pm2": "^6.0.14",
    "react": "19.2.8",
    "react-bootstrap": "^2.10.10",
    "react-dom": "19.2.8",
    "react-hot-toast": "^2.5.2",
    "react-icons": "^5.5.0",
    "react-markdown": "^10.1.0",
    "react-rating": "^2.0.5",
    "react-redux": "^9.2.0",
    "react-spinners": "^0.17.0",
    "react-star-ratings": "^2.3.0",
    "react-toastify": "^11.1.0",
    "sweetalert2": "^11.26.24",
    "swiper": "^11.2.8",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.0"
  },
  "optionalDependencies": {
    "@tailwindcss/oxide-linux-x64-gnu": "4.0.0",
    "lightningcss-linux-x64-gnu": "1.28.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "eslint": "^9.39.1",
    "eslint-config-next": "^15.5.22",
    "typescript": "^5.9.3"
  }
}
